#. Notepad.PHO_STRINGS.BLACKBOARD.DESC
msgctxt "Notepad.PHO_STRINGS.BLACKBOARD.DESC"
msgid ""
"This board is perfect for remembering complicated calculations ... But how "
"did the dups get chalk?"
msgstr ""
"Ce tableau est parfait pour retenir les calculs compliqués … mais comment "
"les dups ont eu de la craie ?"

#. Notepad.PHO_STRINGS.BLACKBOARD.NAME
msgctxt "Notepad.PHO_STRINGS.BLACKBOARD.NAME"
msgid "Blackboard"
msgstr "Tableau à craie"

#. Notepad.PHO_STRINGS.BLUEPRINT.DESC
msgctxt "Notepad.PHO_STRINGS.BLUEPRINT.DESC"
msgid "Plan your setups."
msgstr "Planifiez vos setups."

#. Notepad.PHO_STRINGS.BLUEPRINT.NAME
msgctxt "Notepad.PHO_STRINGS.BLUEPRINT.NAME"
msgid "Blueprint"
msgstr "Plan"

#. Notepad.PHO_STRINGS.DIODE.DESC
msgctxt "Notepad.PHO_STRINGS.DIODE.DESC"
msgid "A diode."
msgstr "Une diode."

#. Notepad.PHO_STRINGS.DIODE.NAME
msgctxt "Notepad.PHO_STRINGS.DIODE.NAME"
msgid "Diode"
msgstr "Diode"

#. Notepad.PHO_STRINGS.LED.DESC
msgctxt "Notepad.PHO_STRINGS.LED.DESC"
msgid "A green led to show logic port states."
msgstr "Une LED verte qui affiche l'état d'un circuit logique."

#. Notepad.PHO_STRINGS.LED.EFFECT
msgctxt "Notepad.PHO_STRINGS.LED.EFFECT"
msgid "LEDs are directly powered by the logic circuit, they don't need power."
msgstr ""
"Les LED sont alimentées directement par le circuit logique, elles n'ont pas "
"besoin d'alimentation."

#. Notepad.PHO_STRINGS.LED.NAME
msgctxt "Notepad.PHO_STRINGS.LED.NAME"
msgid "LED"
msgstr "LED"

#. Notepad.PHO_STRINGS.LED_RED_GREEN.DESC
msgctxt "Notepad.PHO_STRINGS.LED_RED_GREEN.DESC"
msgid "A red-green LED that shows the logic cable state."
msgstr "Une LED rouge-verte qui affiche l'état d'un circuit logique."

#. Notepad.PHO_STRINGS.LED_RED_GREEN.NAME
msgctxt "Notepad.PHO_STRINGS.LED_RED_GREEN.NAME"
msgid "Red-green LED"
msgstr "LED Rouge-verte"

#. Notepad.PHO_STRINGS.NOTEPAD.DESC
msgctxt "Notepad.PHO_STRINGS.NOTEPAD.DESC"
msgid "Your dupes have no memory? Let them have a silly thought!"
msgstr "Vos dup n'ont pas de memoire? Laissez leur un pense bête!"

#. Notepad.PHO_STRINGS.NOTEPAD.EFFECT
msgctxt "Notepad.PHO_STRINGS.NOTEPAD.EFFECT"
msgid "Note and commenting on your setups will help you a lot!"
msgstr "Notez et commentez vos installations vous aidera beaucoup !"

#. Notepad.PHO_STRINGS.NOTEPAD.NAME
msgctxt "Notepad.PHO_STRINGS.NOTEPAD.NAME"
msgid "Notepad"
msgstr "Bloc-notes"

#. Notepad.PHO_STRINGS.PIXEL.DESC
msgctxt "Notepad.PHO_STRINGS.PIXEL.DESC"
msgid "A big square pixel."
msgstr "Un gros pixel carré."

#. Notepad.PHO_STRINGS.PIXEL.NAME
msgctxt "Notepad.PHO_STRINGS.PIXEL.NAME"
msgid "Pixel"
msgstr ""

#. Notepad.PHO_STRINGS.POSTIT.DESC
msgctxt "Notepad.PHO_STRINGS.POSTIT.DESC"
msgid "Stick it everywhere !"
msgstr "Collez en partout !"

#. Notepad.PHO_STRINGS.POSTIT.NAME
msgctxt "Notepad.PHO_STRINGS.POSTIT.NAME"
msgid "Post-It"
msgstr "Post-It"

#. Notepad.PHO_STRINGS.STONKS.DESC
msgctxt "Notepad.PHO_STRINGS.STONKS.DESC"
msgid "Track your production."
msgstr "Suivez votre production."

#. Notepad.PHO_STRINGS.STONKS.NAME
msgctxt "Notepad.PHO_STRINGS.STONKS.NAME"
msgid "Stonks"
msgstr "Stonks"

#. Notepad.PHO_STRINGS.TV.DESC
msgctxt "Notepad.PHO_STRINGS.TV.DESC"
msgid ""
"There's no cable here, instead the dupes look at pictures of cute kittens."
msgstr ""
"Ici il n'y a pas le câble, à la place les dups y regardent des photos de "
"chatons mignons."

#. Notepad.PHO_STRINGS.TV.NAME
msgctxt "Notepad.PHO_STRINGS.TV.NAME"
msgid "Tv"
msgstr "Tv"

#. Notepad.PHO_STRINGS.WARNING.DESC
msgctxt "Notepad.PHO_STRINGS.WARNING.DESC"
msgid "Better safe than sorry."
msgstr "Mieux vaut prévenir que guérir."

#. Notepad.PHO_STRINGS.WARNING.NAME
msgctxt "Notepad.PHO_STRINGS.WARNING.NAME"
msgid "Warning Sign"
msgstr "Panneau d'Avertissement"

